
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id         @default(uuid())
  email           String          @unique
  password        String?
  name            String
  image           String?
  admin           Boolean         @default(false)

  offer           Offer[]
  products        Product[]       @relation("UserProducts")
}

model Tag {
  id              Int             @id         @default(autoincrement())
  name            String          @unique

  products        Product[]
}

model ProductType {
  id  Int   @id @default(autoincrement())
  name  String  @unique

  Product  Product?
}

model Product {
  id              Int             @id         @default(autoincrement())
  name            String
  description     String
  images          String[]
  addedAt         DateTime        @default(now())
  addedById       String
  creatorId       Int
  brandId         Int
  tags            Tag[]
  productTypeId   Int             @unique
  ProductType     ProductType     @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  addedBy         User            @relation("UserProducts", fields: [addedById], references: [id])
  creator         Creator?        @relation("CreatorProduct", fields: [creatorId], references: [id])
  brand           Brand?          @relation("BrandProduct", fields: [brandId], references: [id], onDelete: Cascade)
}

model Creator {
  id              Int             @id         @default(autoincrement())
  name            String
  about           String
  description     String?
  image           String?

  products        Product[]       @relation("CreatorProduct")
}

model Brand {
  id              Int             @id         @default(autoincrement())
  name            String          @unique
  about           String
  description     String?
  image           String?

  products        Product[]       @relation("BrandProduct")
}


model Offer {
  id            Int   @id   @default(autoincrement())
  discount      String
  productName   String
  productType   String
  validTill     DateTime
  badge         Badge
  createdAt     DateTime    @default(now())

  addedById     String
  addedBy       User    @relation(fields: [addedById], references: [id])
}

enum Badge {
  Offer
  New
}